[gd_resource type="Resource" script_class="StoryChapter" format=3]

[ext_resource type="Script" path="res://scripts/story/story_chapter.gd" id="1_chapter"]

[resource]
script = ExtResource("1_chapter")
chapter_id = "chapter_01"
chapter_number = 1
title = "El despertar"
description = "Goku despierta desorientado en un entorno distorsionado que asemeja al Valle del Fin. Una entidad desconocida pone a prueba su capacidad de combate antes de abrir una brecha dimensional."
player_character_id = "goku"
opponent_character_id = "dummy"
map_id = "valle_del_fin"
ai_difficulty = 0
intro_dialogue = [{
"event": "fade_in_valley",
"portrait": "goku",
"side": "left",
"speaker": "Goku",
"text": "¿Mmm...? ¿Dónde estoy?"
}, {
"event": "",
"portrait": "goku",
"side": "left",
"speaker": "Goku",
"text": "¡Vaya! Este lugar es increíble. Pero... no recuerdo haber venido aquí."
}, {
"event": "glitch_interference",
"portrait": "unknown",
"side": "right",
"speaker": "???",
"text": "Registro identificado. Son Goku."
}, {
"event": "",
"portrait": "goku",
"side": "left",
"speaker": "Goku",
"text": "¿Eh? ¿Quién anda ahí?"
}, {
"event": "glitch_interference",
"portrait": "unknown",
"side": "right",
"speaker": "???",
"text": "Memoria conservada. Capacidad de combate pendiente de verificación."
}, {
"event": "",
"portrait": "goku",
"side": "left",
"speaker": "Goku",
"text": "No entiendo nada de lo que dices. ¡Sal de una vez!"
}, {
"event": "spawn_dummy",
"portrait": "goku",
"side": "left",
"speaker": "Goku",
"text": "¿Quieres que pelee contra eso? Je... ¡Bueno, supongo que puedo calentar un poco!"
}]
win_dialogue = [{
"event": "dummy_deactivated",
"portrait": "unknown",
"side": "right",
"speaker": "???",
"text": "Verificación completada. Coincidencia: 99,8 %."
}, {
"event": "",
"portrait": "goku",
"side": "left",
"speaker": "Goku",
"text": "¡Eso estuvo fácil! Aunque... ¿qué significa ese porcentaje?"
}, {
"event": "glitch_interference",
"portrait": "unknown",
"side": "right",
"speaker": "???",
"text": "La diferencia será estudiada."
}, {
"event": "",
"portrait": "goku",
"side": "left",
"speaker": "Goku",
"text": "¡Oye, espera! ¡Todavía no me has dicho dónde estoy!"
}, {
"event": "open_rift_stadium",
"portrait": "goku",
"side": "left",
"speaker": "Goku",
"text": "¿Un torneo de artes marciales? ¡Ahora sí se está poniendo interesante!"
}]
lose_dialogue = [{
"event": "",
"portrait": "goku",
"side": "left",
"speaker": "Goku",
"text": "Agh... aún me cuesta coordinar los movimientos en este lugar. Debo intentarlo otra vez."
}]
